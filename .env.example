# Copy this file to `.env` and fill in values. `.env` is git-ignored — never commit it.
# Everything except the model-backed commands works without any of these.

# --- Required only for model-backed commands (analyze, demo's AI step, report --agent, eval --agent)
OPENAI_API_KEY=

# Any OpenAI model that supports function calling in the Responses API.
OPENAI_MODEL=gpt-5.4-mini
# Reasoning effort for reasoning models: none, low, medium, high.
# Use "none" for a model that does not support reasoning.
OPENAI_REASONING_EFFORT=low

# --- Agent limits ------------------------------------------------------------
AGENT_MAX_ITERATIONS=12
AGENT_MAX_TOOL_CALLS=30

# --- Analytical database -------------------------------------------------------
# Where DuckDB files are written (git-ignored).
NORTHSTAR_WAREHOUSE_DIR=warehouse
# Guardrails for the educational read-only SQL tool.
SQL_ROW_LIMIT=200
SQL_TIMEOUT_SECONDS=5

# --- Reporting -------------------------------------------------------------------
REPORTING_TIMEZONE=America/New_York
# "Today" in the fictional dataset. Last week = the Monday-Sunday week before it.
NORTHSTAR_REFERENCE_DATE=2026-11-09

# --- Data source -----------------------------------------------------------------
# "mock" reads the fictional CSVs in data/ (default, no accounts needed).
# "live" uses the read-only API adapters below. They are UNTESTED against real
# accounts — see docs/connecting-real-data.md before trying them.
DATA_SOURCE=mock
LIVE_START_DATE=2026-10-26
LIVE_END_DATE=2026-11-08

# Shopify GraphQL Admin API (custom app token with read_orders, read_products)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10

# Meta Marketing API Insights (token with ads_read)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000000
META_API_VERSION=v26.0

# Google Sheets API (read-only). Use EITHER a service-account JSON file
# (pip install -e ".[live]") OR an OAuth access token.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEETS_ACCESS_TOKEN=
GOOGLE_SHEETS_PRODUCT_COSTS_RANGE=Product Costs!A1:F
GOOGLE_SHEETS_FULFILLMENT_RANGE=Fulfillment Costs!A1:F
GOOGLE_SHEETS_TARGETS_RANGE=Targets!A1:F
